# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/talikhata?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_TRUST_HOST=true

# Google OAuth (required for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI (required for AI voice intent parsing)
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-4.1-mini

# Public canonical URL used by metadata, sitemap and robots.
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Native Capacitor production URL (must be HTTPS in production).
CAP_SERVER_URL=https://your-domain.com
